{
  "manifest_version": 3,
  "name": "ExamTopics Navigator",
  "version": "1.0.0",
  "description": "Navigate between questions and topics on ExamTopics easily",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://examtopics.com/*",
    "https://www.examtopics.com/*",
    "https://www.google.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "examtopics-navigator@example.org"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://examtopics.com/*", "https://www.examtopics.com/*"],
      "js": ["src/content.js", "src/question.js", "src/ai-content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["src/settings.html"],
    "matches": ["https://examtopics.com/*", "https://www.examtopics.com/*"]
  }],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ExamTopics Navigator",
    "default_icon": "icons/icon.png"
  }
}
